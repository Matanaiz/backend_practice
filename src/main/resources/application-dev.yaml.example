# 本地开发环境配置模板
# 使用方法：复制本文件为 application-dev.yaml，填入真实数据库密码后使用
# application-dev.yaml 已被 .gitignore 忽略，不会被提交
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: 'jdbc:mysql://localhost:3306/MyPetStore?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
    username: root
    # 密码请手动填写，注意不要把真实密码提交到版本库
    password:
    hikari:
      connection-init-sql: SET time_zone = '+08:00'
  sql:
    init:
      mode: never
